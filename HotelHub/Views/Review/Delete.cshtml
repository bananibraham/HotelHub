@model HotelHub.Models.Entities.Review

@{
    ViewData["Title"] = "Delete Review";
}

<h1>Delete Review</h1>

<div class="alert alert-danger">
    <h3>Are you sure you want to delete this review?</h3>
</div>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Customer</dt>
        <dd class="col-sm-10">@(Model.Customer?.FirstName + " " + Model.Customer?.LastName)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.BookingId)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.BookingId)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Rating)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Rating)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Comment)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Comment)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ReviewDate)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ReviewDate)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.IsApproved)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.IsApproved)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ReviewId" />
        <input type="submit" value="Confirm Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>