@page
@model LoginModel

@{
    ViewData["Title"] = "Log In";
}

<!-- INNER PAGE HERO BANNER -->
<section class="luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
    <div class="overlay"></div>
    <div class="container text-center position-relative" style="z-index: 2;">
        <p class="breadcrumbs mb-2"><span class="mr-2"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></span> <span>&bull;</span> <span class="text-white">Sign In</span></p>
        <h1 class="bread mb-2">Guest &amp; Staff Access</h1>
        <p class="subtitle">Access your HotelHub reservations, account profile, and operations.</p>
    </div>
</section>

<!-- LOGIN FORM SECTION -->
<section class="ftco-section bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5">
                <div class="auth-card">
                    <div class="auth-header">
                        <h2>Welcome Back</h2>
                        <p>Sign in to your HotelHub account</p>
                    </div>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold text-center" role="alert"></div>

                        <div class="form-group">
                            <label asp-for="Input.Email">Email Address</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.Password">Password</label>
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Enter password" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-group d-flex align-items-center justify-content-between">
                            <div class="custom-control custom-checkbox">
                                <input class="custom-control-input" asp-for="Input.RememberMe" id="rememberMeCheck" />
                                <label class="custom-control-label" for="rememberMeCheck">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
                            </div>
                            <div>
                                <a id="forgot-password" asp-page="./ForgotPassword" class="small text-muted">Forgot password?</a>
                            </div>
                        </div>

                        <div class="form-group mt-4 mb-0">
                            <button id="login-submit" type="submit" class="btn btn-primary btn-auth btn-block">Log in</button>
                        </div>

                        <div class="auth-links">
                            <p class="mb-2">Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="font-weight-bold">Register as a new user</a></p>
                            <p class="mb-0"><a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="small">Resend email confirmation</a></p>
                        </div>
                    </form>

                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <div class="mt-4 pt-3 border-top text-center">
                            <h5 class="small text-muted text-uppercase mb-3">Or sign in with</h5>
                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                <div>
                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit" class="btn btn-outline-secondary btn-sm m-1" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                                    }
                                </div>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
