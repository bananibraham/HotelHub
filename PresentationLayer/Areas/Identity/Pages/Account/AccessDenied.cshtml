@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text d-flex align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate text-center d-flex align-items-end justify-content-center">
                <div class="text">
                    <p class="breadcrumbs mb-2"><span class="mr-2"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></span> <span>Access Denied</span></p>
                    <h1 class="mb-4 bread">Access Denied</h1>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section bg-light py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5">
                <div class="card border-0 shadow-sm p-4 p-md-5 text-center bg-white rounded">
                    <div class="mb-4 d-flex justify-content-center">
                        <div style="width: 80px; height: 80px; border-radius: 50%; background-color: #fee2e2; display: flex; align-items: center; justify-content: center;">
                            <i class="icon-ban text-danger" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>
                    <h2 class="font-weight-bold text-danger mb-2">Access Denied</h2>
                    <p class="text-muted mb-4">
                        You do not have the required role or permission to view this administrative resource.
                    </p>
                    <div class="d-flex justify-content-center">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary px-5 py-3 font-weight-bold shadow-sm" style="border-radius: 30px;">
                            <i class="icon-arrow-left mr-2"></i> Return to Safety
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
