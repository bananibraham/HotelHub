@page
@model IndexModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Manage Your Account";
}

<!-- HERO BANNER -->
<section class="luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
    <div class="overlay"></div>
    <div class="container text-center position-relative" style="z-index: 2;">
        <p class="breadcrumbs mb-2"><span class="mr-2"><a asp-area="" asp-controller="Home" asp-action="Index">Home <i class="ion-ios-arrow-forward"></i></a></span> <span>Account Profile</span></p>
        <h1 class="bread mb-2">Guest Account Settings</h1>
        <p class="subtitle">Manage your verified resident profile, contact coordinates, and security preferences.</p>
    </div>
</section>

<section class="ftco-section bg-light py-5">
    <div class="container">
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert alert-dismissible fade show shadow-sm mb-4" role="alert" style="background-color: #f6fcf7; border: 1px solid #b7e4c7; color: #155724; border-radius: 10px;">
                <div class="d-flex align-items-center">
                    <i class="icon-check-circle mr-2" style="font-size: 1.4rem; color: #28a745;"></i>
                    <strong class="font-weight-600">@Model.StatusMessage</strong>
                </div>
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="row">
            <!-- Navigation Sidebar -->
            <div class="col-md-4 col-lg-3 mb-4">
                <!-- User Profile Card -->
                <div class="luxury-card text-center p-4 mb-3">
                    <div class="position-relative mx-auto mb-3" style="width: 88px;">
                        <div class="profile-avatar-crest">
                            @(Model.Input?.FullName?.Length > 0 ? Model.Input.FullName[0].ToString().ToUpper() : "G")
                        </div>
                        <span class="profile-verified-badge" title="Verified Account">
                            <i class="icon-check"></i>
                        </span>
                    </div>

                    <h4 class="font-weight-bold mb-1 text-dark" style="font-family: 'Playfair Display', Georgia, serif;">
                        @(string.IsNullOrWhiteSpace(Model.Input?.FullName) ? "Resident Guest" : Model.Input.FullName)
                    </h4>
                    <p class="small text-muted mb-2">@Model.Username</p>

                    @if (User.IsInRole("Admin"))
                    {
                        <span class="badge badge-dark px-3 py-1 font-weight-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 1px;">
                            <i class="icon-shield mr-1"></i> Administrator
                        </span>
                    }
                    else if (User.IsInRole("Receptionist"))
                    {
                        <span class="badge badge-info px-3 py-1 font-weight-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 1px;">
                            <i class="icon-bell mr-1"></i> Front Desk Staff
                        </span>
                    }
                    else
                    {
                        <span class="badge-luxury-confirmed px-3 py-1 font-weight-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 1px;">
                            <i class="icon-star mr-1"></i> Verified Resident
                        </span>
                    }
                </div>

                <partial name="_ManageNav" />

                @if (Model.ActiveBookingsCount > 0)
                {
                    <div class="luxury-card mt-3 p-4 text-center">
                        <div class="small text-muted text-uppercase font-weight-bold" style="letter-spacing: 0.5px;">Upcoming Stays</div>
                        <div class="h2 font-weight-bold my-2" style="color: #8d703b; font-family: 'Playfair Display', serif;">@Model.ActiveBookingsCount</div>
                        <a asp-controller="Booking" asp-action="Index" class="btn btn-sm btn-luxury-outline w-100">
                            <i class="icon-calendar mr-1"></i> View Reservations
                        </a>
                    </div>
                }
            </div>

            <!-- Profile Form -->
            <div class="col-md-8 col-lg-9">
                <div class="luxury-card p-4 p-md-5">
                    <div class="border-bottom pb-3 mb-4">
                        <span class="text-uppercase font-weight-bold small" style="color: #8d703b; letter-spacing: 1.5px;">Account Profile &amp; Identity</span>
                        <h2 class="font-weight-bold mb-1 text-dark" style="font-family: 'Playfair Display', Georgia, serif;">
                            Personal Profile &amp; Contact
                        </h2>
                        <p class="text-muted small mb-0">Update your verified legal name, mobile contact coordinates, and identification details.</p>
                    </div>

                    <form id="profile-form" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Input.FullName" class="font-weight-bold small text-muted text-uppercase">Full Legal Name <span class="text-danger">*</span></label>
                                <input asp-for="Input.FullName" class="form-control luxury-input" placeholder="e.g. Omar Abdelrahman" />
                                <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Input.PhoneNumber" class="font-weight-bold small text-muted text-uppercase">Mobile Phone Number <span class="text-danger">*</span></label>
                                <input asp-for="Input.PhoneNumber" class="form-control luxury-input" placeholder="01012345678" />
                                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label class="font-weight-bold small text-muted text-uppercase">Linked Email Address</label>
                            <div class="input-group">
                                <input class="form-control luxury-input bg-light" value="@Model.Username" disabled style="cursor: not-allowed;" />
                                <div class="input-group-append">
                                    <span class="input-group-text bg-light border-left-0 text-muted">
                                        <i class="icon-lock"></i>
                                    </span>
                                </div>
                            </div>
                            <small class="text-muted">Primary account email is linked to your security login credentials.</small>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Input.NationalId" class="font-weight-bold small text-muted text-uppercase">National ID / Passport</label>
                                <input asp-for="Input.NationalId" class="form-control luxury-input" placeholder="14-digit Egyptian National ID or Passport #" maxlength="30" />
                                <span asp-validation-for="Input.NationalId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Input.Address" class="font-weight-bold small text-muted text-uppercase">Street Address</label>
                                <input asp-for="Input.Address" class="form-control luxury-input" placeholder="e.g. 15 Corniche El Nile, Zamalek" />
                                <span asp-validation-for="Input.Address" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Input.City" class="font-weight-bold small text-muted text-uppercase">City</label>
                                <input asp-for="Input.City" class="form-control luxury-input" placeholder="e.g. Cairo" />
                                <span asp-validation-for="Input.City" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Input.Country" class="font-weight-bold small text-muted text-uppercase">Country</label>
                                <input asp-for="Input.Country" class="form-control luxury-input" placeholder="e.g. Egypt" />
                                <span asp-validation-for="Input.Country" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center flex-wrap">
                            <span class="text-muted small mb-2 mb-md-0">
                                <i class="icon-shield mr-1"></i> Data encrypted &amp; stored per resort privacy standards.
                            </span>
                            <button id="update-profile-button" type="submit" class="btn btn-luxury-gold px-5 py-3 shadow-sm border-0 font-weight-bold" style="font-size: 0.95rem; letter-spacing: 0.5px;">
                                <i class="icon-check mr-2"></i> Save Profile Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
