@page
@model ChangePasswordModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Security & Password";
}

<!-- HERO BANNER -->
<section class="luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
    <div class="overlay"></div>
    <div class="container text-center position-relative" style="z-index: 2;">
        <p class="breadcrumbs mb-2"><span class="mr-2"><a asp-area="" asp-controller="Home" asp-action="Index">Home <i class="ion-ios-arrow-forward"></i></a></span> <span>Security Credentials</span></p>
        <h1 class="bread mb-2">Account Security</h1>
        <p class="subtitle">Ensure the safety and confidentiality of your resort account credentials.</p>
    </div>
</section>

<section class="ftco-section bg-light py-5">
    <div class="container">
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert alert-dismissible fade show shadow-sm mb-4" role="alert" style="background-color: #f6fcf7; border: 1px solid #b7e4c7; color: #155724; border-radius: 10px;">
                <div class="d-flex align-items-center">
                    <i class="icon-check-circle mr-2" style="font-size: 1.4rem; color: #28a745;"></i>
                    <strong class="font-weight-600">@Model.StatusMessage</strong>
                </div>
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="row">
            <div class="col-md-4 col-lg-3 mb-4">
                <partial name="_ManageNav" />
            </div>

            <div class="col-md-8 col-lg-9">
                <div class="luxury-card p-4 p-md-5">
                    <div class="border-bottom pb-3 mb-4">
                        <span class="text-uppercase font-weight-bold small" style="color: #8d703b; letter-spacing: 1.5px;">Security &amp; Authentication</span>
                        <h2 class="font-weight-bold mb-1 text-dark" style="font-family: 'Playfair Display', Georgia, serif;">
                            Update Security Password
                        </h2>
                        <p class="text-muted small mb-0">Ensure your account uses a strong, complex password protecting your reservations and billing data.</p>
                    </div>

                    <form id="change-password-form" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Input.OldPassword" class="font-weight-bold small text-muted text-uppercase">Current Password <span class="text-danger">*</span></label>
                            <input asp-for="Input.OldPassword" class="form-control luxury-input" autocomplete="current-password" placeholder="••••••••••••" />
                            <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Input.NewPassword" class="font-weight-bold small text-muted text-uppercase">New Password <span class="text-danger">*</span></label>
                                <input asp-for="Input.NewPassword" class="form-control luxury-input" autocomplete="new-password" placeholder="At least 6 characters" />
                                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 form-group mb-4">
                                <label asp-for="Input.ConfirmPassword" class="font-weight-bold small text-muted text-uppercase">Confirm New Password <span class="text-danger">*</span></label>
                                <input asp-for="Input.ConfirmPassword" class="form-control luxury-input" autocomplete="new-password" placeholder="Repeat new password" />
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="pt-3 border-top d-flex justify-content-between align-items-center flex-wrap">
                            <span class="text-muted small mb-2 mb-md-0">
                                <i class="icon-lock mr-1"></i> Passwords must contain an uppercase letter, number, and special character.
                            </span>
                            <button type="submit" class="btn btn-luxury-gold px-5 py-3 shadow-sm border-0 font-weight-bold" style="font-size: 0.95rem; letter-spacing: 0.5px;">
                                <i class="icon-lock mr-2"></i> Update Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
