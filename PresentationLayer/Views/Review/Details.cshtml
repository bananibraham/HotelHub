@model BLLayer1.ViewModel.ReviewVM

@{
    if (ViewData["Layout"] != null)
    {
        Layout = ViewData["Layout"]?.ToString();
    }
    ViewData["Title"] = $"Review #{Model.ReviewId} Details";
    bool isAdmin = ViewData["Layout"]?.ToString() == "_AdminLayout" || User.IsInRole("Admin");
}

@if (!isAdmin)
{
    <section class="hero-wrap hero-wrap-2 luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
        <div class="overlay"></div>
        <div class="container">
            <div class="row no-gutters slider-text align-items-end justify-content-center">
                <div class="col-md-9 ftco-animate pb-5 text-center">
                    <p class="breadcrumbs">
                        <span class="mr-2"><a asp-controller="Review" asp-action="Index">Reviews <i class="ion-ios-arrow-forward"></i></a></span>
                        <span>Review Statement</span>
                    </p>
                    <h1 class="mb-3 bread">Guest Review Details</h1>
                </div>
            </div>
        </div>
    </section>
}

<div class="@(isAdmin ? "" : "container py-5")">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="luxury-card p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 pb-3 border-bottom">
                    <div>
                        <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.75rem; letter-spacing: 1px;">Testimonial Statement</span>
                        <h2 class="mb-0 font-weight-bold text-dark" style="font-family: 'Playfair Display', Georgia, serif;">Review #@Model.ReviewId</h2>
                    </div>
                    <div class="mt-2 mt-md-0 d-flex align-items-center">
                        <span class="font-weight-bold h4 mb-0 mr-2 text-dark">@Model.Rating.ToString("0.0")</span>
                        <div style="color: #c5a880; font-size: 1.2rem;">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Model.Rating)
                                {
                                    <span>&#9733;</span>
                                }
                                else
                                {
                                    <span class="text-muted" style="opacity: 0.3;">&#9733;</span>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small d-block font-weight-bold text-uppercase">Guest Identity</span>
                            <div class="d-flex align-items-center mt-2">
                                <div class="mr-2 text-white rounded-circle d-flex align-items-center justify-content-center font-weight-bold shadow-sm"
                                     style="width: 32px; height: 32px; background: linear-gradient(135deg, #c5a880, #8d703b); font-size: 0.85rem;">
                                    @(!string.IsNullOrEmpty(Model.CustomerName) ? Model.CustomerName[0].ToString().ToUpper() : "G")
                                </div>
                                <span class="font-weight-bold text-dark">@Model.CustomerName</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small d-block font-weight-bold text-uppercase">Stay Reference</span>
                            <span class="font-weight-bold text-primary mt-2 d-block">
                                <i class="icon-calendar mr-1"></i> @Model.BookingDetails
                            </span>
                        </div>
                    </div>
                </div>

                <div class="p-4 mb-4 rounded" style="background-color: #faf8f5; border-left: 4px solid #c5a880;">
                    <span class="text-muted small font-weight-bold text-uppercase d-block mb-2">Guest Feedback</span>
                    <p class="mb-0 text-dark" style="font-size: 1.05rem; line-height: 1.6; font-style: italic;">
                        "@Model.Comment"
                    </p>
                </div>

                <div class="text-muted small mb-4">
                    <i class="icon-clock-o mr-1"></i> Recorded on: @Model.CreatedAt.ToString("f")
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-luxury-outline">
                        <i class="icon-arrow-left mr-1"></i> Back to Reviews
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.ReviewId" class="btn btn-luxury-gold mr-2">
                                <i class="icon-pencil mr-1"></i> Edit Review
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.ReviewId" class="btn btn-outline-danger">
                                <i class="icon-trash mr-1"></i> Delete
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>