@model BLLayer1.ViewModel.ReviewVM

@{
    if (ViewData["Layout"] != null)
    {
        Layout = ViewData["Layout"]?.ToString();
    }
    ViewData["Title"] = "Modify Guest Review";
    bool isAdmin = ViewData["Layout"]?.ToString() == "_AdminLayout" || User.IsInRole("Admin");
}

@if (!isAdmin)
{
    <section class="hero-wrap hero-wrap-2 luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
        <div class="overlay"></div>
        <div class="container">
            <div class="row no-gutters slider-text align-items-end justify-content-center">
                <div class="col-md-9 ftco-animate pb-5 text-center">
                    <p class="breadcrumbs">
                        <span class="mr-2"><a asp-controller="Review" asp-action="Index">Reviews <i class="ion-ios-arrow-forward"></i></a></span>
                        <span>Edit Review</span>
                    </p>
                    <h1 class="mb-3 bread">Update Testimonial</h1>
                </div>
            </div>
        </div>
    </section>
}

<div class="@(isAdmin ? "" : "container py-5")">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="luxury-card p-4 p-md-5">
                <div class="mb-4 pb-3 border-bottom">
                    <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.75rem; letter-spacing: 1px;">Editorial Moderation</span>
                    <h2 class="mb-1 font-weight-bold text-dark" style="font-family: 'Playfair Display', Georgia, serif;">Modify Guest Review #@Model.ReviewId</h2>
                    <p class="text-muted small mb-0">Update customer association, overall star rating, or testimonial feedback.</p>
                </div>

                <form asp-action="Edit" asp-route-id="@Model.ReviewId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReviewId" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CustomerId" class="font-weight-bold small text-muted text-uppercase">Guest Profile <span class="text-danger">*</span></label>
                            <select asp-for="CustomerId" class="form-control luxury-input" asp-items="ViewBag.Customers"></select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="BookingId" class="font-weight-bold small text-muted text-uppercase">Associated Stay / Booking</label>
                            <select asp-for="BookingId" class="form-control luxury-input" asp-items="ViewBag.Bookings">
                                <option value="">-- General / Walk-in Guest (No Specific Booking) --</option>
                            </select>
                            <span asp-validation-for="BookingId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Rating" class="font-weight-bold small text-muted text-uppercase">Hospitality Rating <span class="text-danger">*</span></label>
                        <select asp-for="Rating" class="form-control luxury-input">
                            <option value="5">★★★★★ 5.0 — Exceptional / Luxurious Stay</option>
                            <option value="4">★★★★☆ 4.0 — Very Good / Enjoyable Stay</option>
                            <option value="3">★★★☆☆ 3.0 — Satisfactory / Average</option>
                            <option value="2">★★☆☆☆ 2.0 — Below Expectations</option>
                            <option value="1">★☆☆☆☆ 1.0 — Poor Experience</option>
                        </select>
                        <span asp-validation-for="Rating" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Comment" class="font-weight-bold small text-muted text-uppercase">Guest Feedback <span class="text-danger">*</span></label>
                        <textarea asp-for="Comment" class="form-control luxury-input" rows="4" style="height: auto;"></textarea>
                        <span asp-validation-for="Comment" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-luxury-outline">
                            <i class="icon-arrow-left mr-1"></i> Back to Reviews
                        </a>
                        <button type="submit" class="btn btn-luxury-gold px-4">
                            <i class="icon-check mr-1"></i> Update Review
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}