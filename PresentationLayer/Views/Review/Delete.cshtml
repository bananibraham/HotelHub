@model BLLayer1.ViewModel.ReviewVM

@{
    ViewData["Title"] = "Delete Review";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i> Confirm Delete
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <h5 class="alert-heading">
                            <i class="fas fa-exclamation-circle"></i> Warning!
                        </h5>
                        <p class="mb-0">
                            Are you sure you want to delete this review? This action cannot be undone.
                        </p>
                    </div>

                    <h5 class="text-danger mb-3">Review Information</h5>
                    
                    <dl class="row">
                        <dt class="col-sm-3 fw-bold">Review ID</dt>
                        <dd class="col-sm-9"><span class="badge bg-secondary">#@Model.ReviewId</span></dd>

                        <dt class="col-sm-3 fw-bold">Customer</dt>
                        <dd class="col-sm-9"><strong>@Model.CustomerName</strong></dd>

                        <dt class="col-sm-3 fw-bold">Rating</dt>
                        <dd class="col-sm-9">
                            @{
                                var stars = new string('★', Model.Rating) + new string('☆', 5 - Model.Rating);
                            }
                            <span class="text-warning">@stars</span> (@Model.Rating/5)
                        </dd>

                        <dt class="col-sm-3 fw-bold">Comment</dt>
                        <dd class="col-sm-9">
                            <div class="border p-3 rounded bg-light">
                                @Model.Comment
                            </div>
                        </dd>

                        <dt class="col-sm-3 fw-bold">Created At</dt>
                        <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                    </dl>

                    <hr />

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="ReviewId" />
                        
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="fas fa-trash"></i> Yes, Delete Review
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>