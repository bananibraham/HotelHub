<!-- 5. OUR ROOMS SECTION (DYNAMIC DATABASE ROOMS) -->
<section class="ftco-section bg-light" id="rooms-section">
    <div class="container">
        <div class="row justify-content-center mb-5 pb-3">
            <div class="col-md-7 heading-section text-center ftco-animate">
                <span class="subheading">Exclusive Resort Accommodations</span>
                <h2 class="mb-4">Our Summer Rooms &amp; Suites</h2>
            </div>
        </div>
        <div class="row">
            @if (Model != null && Model.Any())
            {
                foreach (var room in Model)
                {
                    var price = room.RoomType?.PricePerNight ?? 1500m;
                    <div class="col-sm col-md-6 col-lg-4 ftco-animate mb-4">
                        <div class="room-card-premium">
                            <div class="room-card-img-wrap">
                                <img src="@Url.Content(string.IsNullOrEmpty(room.ImageUrl) ? "~/images/room-1.jpg" : room.ImageUrl)" alt="Room @room.RoomNumber" />
                                <span class="room-badge-category">
                                    <i class="icon-hotel mr-1"></i> Room @room.RoomNumber
                                </span>
                                <span class="room-badge-floor">
                                    Floor @room.Floor
                                </span>
                            </div>
                            <div class="room-card-content">
                                <div>
                                    <h3 class="room-card-title">
                                        <a asp-controller="Booking" asp-action="Checkout" asp-route-roomId="@room.Id">
                                            @(room.RoomType?.Name ?? "Deluxe Suite")
                                        </a>
                                    </h3>
                                    <p class="text-muted small mb-3">
                                        @(string.IsNullOrEmpty(room.Description) ? (room.RoomType?.Description ?? "Luxury seaside accommodations with modern comfort and panoramic views.") : room.Description)
                                    </p>
                                    <div class="amenity-chip-list">
                                        <span class="amenity-chip"><i class="icon-users"></i> Up to @(room.RoomType?.Capacity ?? 2) Guests</span>
                                        <span class="amenity-chip"><i class="icon-wifi"></i> Free WiFi</span>
                                        <span class="amenity-chip"><i class="icon-snowflake-o"></i> AC</span>
                                    </div>
                                </div>
                                <div class="pt-3 border-top">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                            <span class="small text-muted d-block">Starting from</span>
                                            <span class="h4 font-weight-bold mb-0" style="color: #8d703b; font-family: 'Playfair Display', Georgia, serif;">
                                                @price.ToString("N0") EGP
                                            </span>
                                            <small class="text-muted"> / night</small>
                                        </div>
                                    </div>
                                    <a asp-controller="Booking" asp-action="Checkout" asp-route-roomId="@room.Id" class="btn-luxury-gold w-100 font-weight-bold">
                                        Reserve Suite <i class="icon-arrow-right ml-2"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">No rooms currently available in the resort catalog.</p>
                </div>
            }
        </div>
    </div>
</section>

