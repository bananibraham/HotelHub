@model DataAccessLayer.Models.Invoice

@{
    if (ViewData["Layout"] != null)
    {
        Layout = ViewData["Layout"]?.ToString();
    }
    ViewData["Title"] = $"Invoice {Model.InvoiceNumber}";
    bool isAdmin = ViewData["Layout"]?.ToString() == "_AdminLayout" || User.IsInRole("Admin");
    bool isStaff = User.IsInRole("Admin") || User.IsInRole("Receptionist");
    bool isFullyPaid = Model.RemainingAmount <= 0;
}

@if (!isAdmin)
{
    <section class="hero-wrap hero-wrap-2" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');" data-stellar-background-ratio="0.5">
        <div class="overlay"></div>
        <div class="container">
            <div class="row no-gutters slider-text align-items-end justify-content-center">
                <div class="col-md-9 ftco-animate pb-5 text-center">
                    <p class="breadcrumbs">
                        <span class="mr-2"><a asp-action="Index">Invoices <i class="ion-ios-arrow-forward"></i></a></span>
                        <span>Statement</span>
                    </p>
                    <h1 class="mb-3 bread">Invoice Statement</h1>
                </div>
            </div>
        </div>
    </section>
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm bg-white p-4 p-md-5" style="border-radius: 12px;">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap">
                    <div>
                        <span class="text-muted small text-uppercase font-weight-bold">HotelHub Luxury Resort Receipt</span>
                        <h2 class="mb-0 font-weight-bold text-dark">Invoice #@Model.InvoiceNumber</h2>
                    </div>
                    <div class="mt-2 mt-md-0">
                        @if (isFullyPaid)
                        {
                            <span class="badge badge-success px-3 py-2 text-uppercase" style="font-size: 0.9rem;">
                                <i class="icon-check mr-1"></i> Paid in Full
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-warning text-dark px-3 py-2 text-uppercase" style="font-size: 0.9rem;">
                                <i class="icon-clock-o mr-1"></i> Balance Due
                            </span>
                        }
                    </div>
                </div>

                <div class="row mb-4 bg-light rounded p-3 mx-0">
                    <div class="col-md-4 text-center p-2">
                        <span class="text-muted small text-uppercase font-weight-bold">Total Billable</span>
                        <h3 class="mb-0 mt-1 font-weight-bold" style="color:#8d703b;">@Model.TotalAmount.ToString("N2") EGP</h3>
                    </div>
                    <div class="col-md-4 text-center p-2 border-left border-right">
                        <span class="text-muted small text-uppercase font-weight-bold">Settled to Date</span>
                        <h3 class="mb-0 mt-1 font-weight-bold text-success">@Model.PaidAmount.ToString("N2") EGP</h3>
                    </div>
                    <div class="col-md-4 text-center p-2">
                        <span class="text-muted small text-uppercase font-weight-bold">Outstanding Balance</span>
                        <h3 class="mb-0 mt-1 font-weight-bold text-danger">@Model.RemainingAmount.ToString("N2") EGP</h3>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <div class="p-3 border rounded">
                            <span class="text-muted small text-uppercase font-weight-bold">Reservation Reference</span>
                            <h5 class="mt-1 mb-1 font-weight-bold text-dark">Booking #@Model.BookingId</h5>
                            <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.BookingId" class="small text-primary font-weight-bold">
                                View Booking Details <i class="icon-arrow-right"></i>
                            </a>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="p-3 border rounded">
                            <span class="text-muted small text-uppercase font-weight-bold">Issue Date</span>
                            <h5 class="mt-1 mb-1 font-weight-bold text-dark">@Model.IssueDate.ToString("dd MMMM yyyy")</h5>
                            <small class="text-muted">Recorded: @Model.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</small>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 mb-2">
                        <i class="icon-arrow-left mr-1"></i> Back
                    </a>

                    <div>
                        <button onclick="window.print()" class="btn btn-outline-info px-4 py-2 mr-2 mb-2">
                            <i class="icon-print mr-1"></i> Print Invoice
                        </button>

                        @if (!isFullyPaid)
                        {
                            <a asp-controller="Payment" asp-action="Checkout" asp-route-bookingId="@Model.BookingId" class="btn btn-success px-4 py-2 mr-2 mb-2">
                                <i class="icon-credit-card mr-1"></i> Settle Balance
                            </a>
                        }

                        @if (isStaff)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.InvoiceId" class="btn btn-primary px-4 py-2 mb-2">
                                <i class="icon-pencil mr-1"></i> Add Room Services
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
