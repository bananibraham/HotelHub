@model IEnumerable<DataAccessLayer.Models.Invoice>
@{
    ViewData["Title"] = "My Invoices - HotelHub";
}

<!-- HERO BANNER -->
<section class="luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
    <div class="overlay"></div>
    <div class="container text-center position-relative" style="z-index: 2;">
        <p class="breadcrumbs mb-2">
            <span class="mr-2"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></span> 
            <span class="mr-2">&bull;</span>
            <span class="text-white">Billing</span>
        </p>
        <h1 class="bread mb-2">Billing Statements</h1>
        <p class="subtitle">Official itemized billing statements for your resort reservations.</p>
    </div>
</section>

<section class="ftco-section bg-light py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
            <div>
                <span class="text-uppercase small font-weight-bold" style="color: #8d703b; letter-spacing: 1px;">Guest Accounting</span>
                <h2 class="font-weight-bold mb-1 text-dark" style="font-family: 'Playfair Display', Georgia, serif;">
                    Resort Statements &amp; Invoices
                </h2>
                <p class="text-muted small mb-0">Review invoice totals, payments settled, and outstanding balances in Egyptian Pounds (EGP).</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-controller="Booking" asp-action="Index" class="btn-luxury-outline">
                    <i class="icon-calendar mr-2"></i> My Bookings
                </a>
            </div>
        </div>

        <div class="luxury-card">
            <div class="table-responsive">
                <table class="table table-luxury mb-0">
                    <thead>
                        <tr>
                            <th>Invoice #</th>
                            <th>Reservation Ref</th>
                            <th>Total Billable</th>
                            <th>Paid to Date</th>
                            <th>Outstanding</th>
                            <th>Issue Date</th>
                            <th class="text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong style="color: #8d703b;">@item.InvoiceNumber</strong>
                                    </td>
                                    <td>
                                        <a asp-controller="Booking" asp-action="Details" asp-route-id="@item.BookingId" class="font-weight-bold text-dark">
                                            #HH-@item.BookingId.ToString("D5")
                                        </a>
                                    </td>
                                    <td>
                                        <span class="font-weight-bold text-dark">@item.TotalAmount.ToString("N2") EGP</span>
                                    </td>
                                    <td>
                                        <span class="font-weight-bold text-success">@item.PaidAmount.ToString("N2") EGP</span>
                                    </td>
                                    <td>
                                        @if (item.RemainingAmount > 0)
                                        {
                                            <span class="font-weight-bold text-danger">@item.RemainingAmount.ToString("N2") EGP</span>
                                        }
                                        else
                                        {
                                            <span class="badge-luxury-confirmed">Settled in Full</span>
                                        }
                                    </td>
                                    <td>@item.IssueDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-right">
                                        <div class="d-inline-flex" style="gap: 6px;">
                                            <a asp-action="Details" asp-route-id="@item.InvoiceId" class="btn btn-sm btn-outline-secondary">
                                                <i class="icon-eye mr-1"></i> Statement
                                            </a>
                                            @if (item.RemainingAmount > 0)
                                            {
                                                <a asp-controller="Payment" asp-action="Checkout" asp-route-bookingId="@item.BookingId" class="btn btn-sm btn-luxury-gold py-1 px-3">
                                                    <i class="icon-credit-card mr-1"></i> Pay Due
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="icon-file-text mb-2" style="font-size: 3rem; color: #8d703b;"></i>
                                    <h5 class="font-weight-bold text-dark mt-2" style="font-family: 'Playfair Display', Georgia, serif;">No Statements Generated</h5>
                                    <p class="mb-0">No billing invoices have been created for your account yet.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
