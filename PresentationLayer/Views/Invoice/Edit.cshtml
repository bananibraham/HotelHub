@model DataAccessLayer.Models.Invoice

@{
    if (ViewData["Layout"] != null)
    {
        Layout = ViewData["Layout"]?.ToString();
    }
    ViewData["Title"] = $"Edit Invoice #{Model.InvoiceNumber}";
    bool isAdmin = ViewData["Layout"]?.ToString() == "_AdminLayout" || User.IsInRole("Admin");
}

@if (!isAdmin)
{
    <section class="hero-wrap hero-wrap-2 luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
        <div class="overlay"></div>
        <div class="container">
            <div class="row no-gutters slider-text align-items-end justify-content-center">
                <div class="col-md-9 ftco-animate pb-5 text-center">
                    <p class="breadcrumbs">
                        <span class="mr-2"><a asp-action="Index">Invoices <i class="ion-ios-arrow-forward"></i></a></span>
                        <span>Edit</span>
                    </p>
                    <h1 class="mb-3 bread">Update Invoice</h1>
                </div>
            </div>
        </div>
    </section>
}

<div class="@(isAdmin ? "" : "container py-5")">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="luxury-card p-4 p-md-5">
                <div class="mb-4 pb-3 border-bottom">
                    <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.75rem; letter-spacing: 1px;">Billing &amp; Financial Ledger</span>
                    <h2 class="mb-1 font-weight-bold text-dark" style="font-family: 'Playfair Display', Georgia, serif;">Update Invoice #@Model.InvoiceNumber</h2>
                    <p class="text-muted small mb-0">Modify invoice reference or issue timestamp. Ledger amounts are calculated automatically.</p>
                </div>

                <form asp-action="Edit" asp-route-id="@Model.InvoiceId" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="InvoiceId" type="hidden" />
                    <input asp-for="CreatedAt" type="hidden" />
                    <input asp-for="TotalAmount" type="hidden" />
                    <input asp-for="PaidAmount" type="hidden" />
                    <input asp-for="RemainingAmount" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="form-group mb-3">
                        <label asp-for="BookingId" class="font-weight-bold small text-muted text-uppercase">Stay Reference <span class="text-danger">*</span></label>
                        <select asp-for="BookingId" asp-items="ViewBag.Bookings" class="form-control luxury-input">
                            <option value="">-- Select Booking --</option>
                        </select>
                        <span asp-validation-for="BookingId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="InvoiceNumber" class="font-weight-bold small text-muted text-uppercase">Invoice Reference <span class="text-danger">*</span></label>
                            <input asp-for="InvoiceNumber" class="form-control luxury-input" />
                            <span asp-validation-for="InvoiceNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="IssueDate" class="font-weight-bold small text-muted text-uppercase">Issue Date <span class="text-danger">*</span></label>
                            <input asp-for="IssueDate" type="date" class="form-control luxury-input" />
                            <span asp-validation-for="IssueDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row bg-light p-3 rounded mb-4 mx-0">
                        <div class="col-4 text-center">
                            <small class="text-muted d-block text-uppercase font-weight-bold">Total Billable</small>
                            <strong class="text-dark" style="font-size: 1.1rem;">@Model.TotalAmount.ToString("N2") EGP</strong>
                        </div>
                        <div class="col-4 text-center">
                            <small class="text-muted d-block text-uppercase font-weight-bold">Settled</small>
                            <strong class="text-success" style="font-size: 1.1rem;">@Model.PaidAmount.ToString("N2") EGP</strong>
                        </div>
                        <div class="col-4 text-center">
                            <small class="text-muted d-block text-uppercase font-weight-bold">Remaining</small>
                            <strong class="@(Model.RemainingAmount > 0 ? "text-danger" : "text-muted")" style="font-size: 1.1rem;">
                                @Model.RemainingAmount.ToString("N2") EGP
                            </strong>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-luxury-outline">
                            <i class="icon-arrow-left mr-1"></i> Back to Invoices
                        </a>
                        <button type="submit" class="btn btn-luxury-gold px-4">
                            <i class="icon-check mr-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
