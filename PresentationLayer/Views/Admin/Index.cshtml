@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- HERO BANNER -->
<div class="hero-wrap" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text d-flex align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate text-center d-flex align-items-end justify-content-center">
                <div class="text">
                    <p class="breadcrumbs mb-2"><span class="mr-2"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></span> <span>Admin</span></p>
                    <h1 class="mb-4 bread">Admin Dashboard</h1>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card shadow-sm border-0 p-4">
                    <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3">
                        <div>
                            <h2 class="h4 mb-0 text-primary">Administrator Control Panel</h2>
                            <p class="text-muted mb-0">Authorized Admin: <strong>@User.Identity?.Name</strong></p>
                        </div>
                        <span class="badge badge-primary px-3 py-2 text-uppercase" style="font-size: 0.9rem;">Role: Admin</span>
                    </div>

                    <div class="alert alert-success d-flex align-items-center" role="alert">
                        <div>
                            <h5 class="alert-heading mb-1"><i class="icon-check-circle"></i> Authorization Verified!</h5>
                            <p class="mb-0">You have successfully passed <code>[Authorize(Roles = "Admin")]</code>. Only users with the <strong>Admin</strong> role can view this page.</p>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-4 mb-3">
                            <div class="p-3 bg-white border rounded text-center">
                                <h6 class="text-muted text-uppercase mb-2">User Management</h6>
                                <p class="small text-muted mb-0">Manage roles, receptionist accounts, and staff access.</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="p-3 bg-white border rounded text-center">
                                <h6 class="text-muted text-uppercase mb-2">System Config</h6>
                                <p class="small text-muted mb-0">Configure hotel parameters, pricing, and system policies.</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="p-3 bg-white border rounded text-center">
                                <h6 class="text-muted text-uppercase mb-2">Hotel Overview</h6>
                                <p class="small text-muted mb-0">Monitor room allocations, reservations, and analytics.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
