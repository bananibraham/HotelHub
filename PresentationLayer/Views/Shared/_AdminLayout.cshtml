@inject PresentationLayer.Services.IUserService UserService
@{
    var adminName = await UserService.GetDisplayNameAsync(User);
    var currentCtrl = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotelHub Management</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/open-iconic-bootstrap.min.css">
    <link rel="stylesheet" href="~/css/animate.css">
    <link rel="stylesheet" href="~/css/ionicons.min.css">
    <link rel="stylesheet" href="~/css/flaticon.css">
    <link rel="stylesheet" href="~/css/icomoon.css">
    <link rel="stylesheet" href="~/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/site.css">

    <style>
        :root {
            --admin-sidebar-bg: #11141a;
            --admin-sidebar-hover: #1c212a;
            --admin-gold: #c5a880;
            --admin-gold-hover: #d8be99;
            --admin-border: #262c37;
        }

        body {
            background-color: #f4f6f9;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .admin-sidebar {
            width: 260px;
            background: var(--admin-sidebar-bg);
            color: #c2c7d0;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            border-right: 1px solid var(--admin-border);
            z-index: 1000;
        }

        .admin-brand {
            padding: 24px 20px;
            border-bottom: 1px solid var(--admin-border);
            background: #0d0f14;
        }

        .admin-brand a {
            color: #fff;
            font-size: 1.3rem;
            font-weight: 700;
            text-decoration: none;
            display: flex;
            align-items: center;
        }

        .admin-brand a span {
            color: var(--admin-gold);
            margin-left: 4px;
        }

        .admin-profile {
            padding: 20px;
            border-bottom: 1px solid var(--admin-border);
            display: flex;
            align-items: center;
        }

        .admin-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--admin-gold), #8d703b);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.1rem;
            margin-right: 12px;
            border: 2px solid rgba(255,255,255,0.1);
        }

        .admin-profile-info .greeting {
            font-size: 0.75rem;
            text-transform: uppercase;
            color: #8892a0;
            letter-spacing: 0.5px;
        }

        .admin-profile-info .name {
            font-size: 0.95rem;
            font-weight: 600;
            color: #fff;
            margin: 0;
        }

        .admin-nav {
            padding: 15px 0;
            flex-grow: 1;
        }

        .admin-nav-header {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #5d6778;
            padding: 10px 22px 6px;
            font-weight: 600;
        }

        .admin-nav ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .admin-nav-link {
            display: flex;
            align-items: center;
            padding: 12px 22px;
            color: #a4b1c2;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }

        .admin-nav-link i {
            font-size: 1.15rem;
            margin-right: 14px;
            width: 20px;
            text-align: center;
            color: #7b889b;
        }

        .admin-nav-link:hover {
            color: #fff;
            background: var(--admin-sidebar-hover);
            text-decoration: none;
        }

        .admin-nav-link:hover i {
            color: var(--admin-gold);
        }

        .admin-nav-link.active {
            color: #fff;
            background: #171d26;
            border-left-color: var(--admin-gold);
            font-weight: 600;
        }

        .admin-nav-link.active i {
            color: var(--admin-gold);
        }

        /* MAIN BODY */
        .admin-main {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        /* TOPBAR */
        .admin-topbar {
            height: 70px;
            background: #fff;
            border-bottom: 1px solid #e3e6ec;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.03);
        }

        .admin-topbar-title {
            font-size: 1.15rem;
            font-weight: 600;
            color: #212529;
            margin: 0;
        }

        .admin-topbar-actions {
            display: flex;
            align-items: center;
        }

        .admin-content {
            padding: 30px;
            flex-grow: 1;
        }

        .btn-gold {
            background-color: var(--admin-gold);
            border-color: var(--admin-gold);
            color: #fff;
        }

        .btn-gold:hover {
            background-color: var(--admin-gold-hover);
            color: #fff;
        }

        .badge-pill-status {
            font-size: 0.8rem;
            padding: 5px 12px;
            border-radius: 20px;
        }

        @@media (max-width: 991.98px) {
            .admin-sidebar {
                width: 70px;
            }
            .admin-brand a span,
            .admin-profile-info,
            .admin-nav-header,
            .admin-nav-link span {
                display: none;
            }
            .admin-nav-link {
                justify-content: center;
                padding: 15px 0;
            }
            .admin-nav-link i {
                margin-right: 0;
            }
        }
    </style>
</head>
<body>
    <div class="admin-wrapper">
        <!-- SIDEBAR -->
        <aside class="admin-sidebar">
            <div class="admin-brand">
                <a asp-controller="Admin" asp-action="Index">
                    <i class="icon-building mr-2 text-warning"></i>
                    Hotel<span>Hub</span>
                </a>
            </div>

            <div class="admin-profile">
                <div class="admin-avatar">
                    @(adminName.Length > 0 ? adminName[0].ToString().ToUpper() : "A")
                </div>
                <div class="admin-profile-info">
                    <div class="greeting">Welcome back,</div>
                    <div class="name">@adminName</div>
                </div>
            </div>

            <nav class="admin-nav">
                <div class="admin-nav-header">Overview</div>
                <ul>
                    <li>
                        <a asp-controller="Admin" asp-action="Index" class="admin-nav-link @(currentCtrl == "Admin" ? "active" : "")">
                            <i class="icon-dashboard"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                </ul>

                <div class="admin-nav-header mt-3">Hotel Inventory</div>
                <ul>
                    <li>
                        <a asp-controller="Room" asp-action="Index" class="admin-nav-link @(currentCtrl == "Room" ? "active" : "")">
                            <i class="icon-bed"></i>
                            <span>Rooms</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="RoomType" asp-action="Index" class="admin-nav-link @(currentCtrl == "RoomType" ? "active" : "")">
                            <i class="icon-th-list"></i>
                            <span>Room Types</span>
                        </a>
                    </li>
                </ul>

                <div class="admin-nav-header mt-3">Operations &amp; Guests</div>
                <ul>
                    <li>
                        <a asp-controller="Booking" asp-action="Index" class="admin-nav-link @(currentCtrl == "Booking" ? "active" : "")">
                            <i class="icon-calendar"></i>
                            <span>Bookings</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Customer" asp-action="Index" class="admin-nav-link @(currentCtrl == "Customer" ? "active" : "")">
                            <i class="icon-users"></i>
                            <span>Customers</span>
                        </a>
                    </li>
                </ul>

                <div class="admin-nav-header mt-3">Financials &amp; Quality</div>
                <ul>
                    <li>
                        <a asp-controller="Invoice" asp-action="Index" class="admin-nav-link @(currentCtrl == "Invoice" ? "active" : "")">
                            <i class="icon-file-text"></i>
                            <span>Invoices</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Payment" asp-action="Index" class="admin-nav-link @(currentCtrl == "Payment" ? "active" : "")">
                            <i class="icon-credit-card"></i>
                            <span>Payments</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Review" asp-action="Index" class="admin-nav-link @(currentCtrl == "Review" ? "active" : "")">
                            <i class="icon-star"></i>
                            <span>Reviews</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- MAIN AREA -->
        <div class="admin-main">
            <!-- TOPBAR -->
            <header class="admin-topbar">
                <div class="admin-topbar-title">
                    @ViewData["Title"]
                </div>

                <div class="admin-topbar-actions">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary mr-3" target="_blank">
                        <i class="icon-external-link mr-1"></i> Public Website
                    </a>

                    <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="icon-sign-out mr-1"></i> Logout
                        </button>
                    </form>
                </div>
            </header>

            <!-- CONTENT -->
            <main class="admin-content">
                @if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
                        <i class="icon-check mr-2"></i>
                        @(TempData["Success"] ?? TempData["SuccessMessage"])
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                        <i class="icon-exclamation-triangle mr-2"></i>
                        @(TempData["Error"] ?? TempData["ErrorMessage"])
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/jquery-migrate-3.0.1.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
