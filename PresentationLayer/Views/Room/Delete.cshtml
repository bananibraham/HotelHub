@model DataAccessLayer.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<h1>Delete Room</h1>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this room?</h4>
    <p>This action cannot be undone.</p>
</div>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Room Number
            </dt>
            <dd class="col-sm-9">
                @Model.RoomNumber
            </dd>

            <dt class="col-sm-3">
                Room Type
            </dt>
            <dd class="col-sm-9">
                @Model.RoomType?.Name
            </dd>

            <dt class="col-sm-3">
                Floor
            </dt>
            <dd class="col-sm-9">
                @Model.Floor
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>
            <dd class="col-sm-9">
                @Model.Status
            </dd>

            <dt class="col-sm-3">
                Description
            </dt>
            <dd class="col-sm-9">
                @Model.Description
            </dd>

        </dl>

        <form asp-action="Delete" method="post">

            <input type="hidden"
                   asp-for="Id" />

            <button type="submit"
                    class="btn btn-danger">
                Delete
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>