@model DataAccessLayer.Models.Payment

@{
    ViewData["Title"] = "Delete Payment";
}

<h1>Delete Payment</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this payment?
</div>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Payment ID
    </dt>

    <dd class="col-sm-9">
        @Model.PaymentId
    </dd>


    <dt class="col-sm-3">
        Booking ID
    </dt>

    <dd class="col-sm-9">
        @Model.BookingId
    </dd>


    <dt class="col-sm-3">
        Amount
    </dt>

    <dd class="col-sm-9">
        @Model.Amount
    </dd>

</dl>


<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="PaymentId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>