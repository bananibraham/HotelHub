@model DataAccessLayer.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
    bool isAdmin = User.IsInRole("Admin");
    bool isReceptionist = User.IsInRole("Receptionist");
}

<section class="hero-wrap hero-wrap-2"
         style="background-image: url('@Url.Content("~/images/bg_1.jpg")');"
         data-stellar-background-ratio="0.5">

    <div class="overlay"></div>

    <div class="container">
        <div class="row no-gutters slider-text align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate pb-5 text-center">

                <p class="breadcrumbs">
                    <span class="mr-2">
                        <a asp-action="Index">
                            Payments
                            <i class="ion-ios-arrow-forward"></i>
                        </a>
                    </span>

                    <span>Details</span>
                </p>

                <h1 class="mb-3 bread">Payment Details</h1>

            </div>
        </div>
    </div>
</section>

<section class="ftco-section bg-light">
    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-9">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4 p-md-5">

                        <div class="text-center mb-5">

                            <div class="mb-3">
                                <i class="icon-credit-card"
                                   style="font-size:55px;color:#8d703b;"></i>
                            </div>

                            <span class="subheading">
                                Payment Transaction
                            </span>

                            <h2>
                                Payment #@Model.PaymentId
                            </h2>

                            <h3 style="color:#8d703b;">
                                @Model.Amount.ToString("N2") EGP
                            </h3>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-4">

                                <div class="p-4 bg-light h-100">

                                    <span class="text-muted small">
                                        BOOKING
                                    </span>

                                    <h4 class="mt-2">
                                        #@Model.BookingId
                                    </h4>

                                </div>

                            </div>

                            <div class="col-md-6 mb-4">

                                <div class="p-4 bg-light h-100">

                                    <span class="text-muted small">
                                        PAYMENT METHOD
                                    </span>

                                    <h4 class="mt-2">
                                        @Model.PaymentMethod
                                    </h4>

                                </div>

                            </div>

                            <div class="col-md-6 mb-4">

                                <div class="p-4 bg-light h-100">

                                    <span class="text-muted small">
                                        PAYMENT DATE
                                    </span>

                                    <h4 class="mt-2">
                                        @Model.PaymentDate.ToString("dd MMM yyyy")
                                    </h4>

                                    <small class="text-muted">
                                        @Model.PaymentDate.ToString("hh:mm tt")
                                    </small>

                                </div>

                            </div>

                            <div class="col-md-6 mb-4">

                                <div class="p-4 bg-light h-100">

                                    <span class="text-muted small">
                                        CREATED AT
                                    </span>

                                    <h4 class="mt-2">
                                        @Model.CreatedAt.ToString("dd MMM yyyy")
                                    </h4>

                                    <small class="text-muted">
                                        @Model.CreatedAt.ToString("hh:mm tt")
                                    </small>

                                </div>

                            </div>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.TransactionId))
                        {
                            <div class="mb-4">

                                <span class="text-muted small">
                                    TRANSACTION ID
                                </span>

                                <div class="p-3 bg-light mt-2">
                                    @Model.TransactionId
                                </div>

                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Notes))
                        {
                            <div class="mb-4">

                                <span class="text-muted small">
                                    NOTES
                                </span>

                                <div class="p-3 bg-light mt-2">
                                    @Model.Notes
                                </div>

                            </div>
                        }

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between flex-wrap">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4 py-3 mb-2">
                                <i class="icon-arrow-left mr-2"></i>
                                Back
                            </a>

                            <div>

                                @if (isAdmin || isReceptionist)
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@Model.PaymentId"
                                       class="btn btn-primary px-4 py-3 mr-2 mb-2">
                                        <i class="icon-pencil mr-2"></i>
                                        Edit
                                    </a>
                                }

                                @if (isAdmin)
                                {
                                    <a asp-action="Delete"
                                       asp-route-id="@Model.PaymentId"
                                       class="btn btn-outline-danger px-4 py-3 mb-2">
                                        <i class="icon-trash mr-2"></i>
                                        Delete
                                    </a>
                                }

                            </div>

                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
</section>