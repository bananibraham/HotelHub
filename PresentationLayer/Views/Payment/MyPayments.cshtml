@model IEnumerable<DataAccessLayer.Models.Payment>
@{
    ViewData["Title"] = "My Payment Receipts - HotelHub";
}

<!-- HERO BANNER -->
<section class="luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
    <div class="overlay"></div>
    <div class="container text-center position-relative" style="z-index: 2;">
        <p class="breadcrumbs mb-2">
            <span class="mr-2"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></span> 
            <span class="mr-2">&bull;</span>
            <span class="text-white">Receipts</span>
        </p>
        <h1 class="bread mb-2">Payment Transactions</h1>
        <p class="subtitle">Audited financial records and settlement receipts for your resort reservations.</p>
    </div>
</section>

<section class="ftco-section bg-light py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
            <div>
                <span class="text-uppercase small font-weight-bold" style="color: #8d703b; letter-spacing: 1px;">Audit Ledger</span>
                <h2 class="font-weight-bold mb-1 text-dark" style="font-family: 'Playfair Display', Georgia, serif;">
                    Transaction Receipts
                </h2>
                <p class="text-muted small mb-0">Record of all settlements applied towards your resort accommodations.</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-controller="Booking" asp-action="Index" class="btn-luxury-outline">
                    <i class="icon-calendar mr-2"></i> My Bookings
                </a>
            </div>
        </div>

        <div class="luxury-card">
            <div class="table-responsive">
                <table class="table table-luxury mb-0">
                    <thead>
                        <tr>
                            <th>Receipt ID</th>
                            <th>Reservation Ref</th>
                            <th>Amount Paid</th>
                            <th>Payment Channel</th>
                            <th>Settlement Date</th>
                            <th class="text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong style="color: #8d703b;">PAY-@item.PaymentId</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.TransactionId))
                                        {
                                            <small class="text-muted d-block font-mono">@item.TransactionId</small>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Booking" asp-action="Details" asp-route-id="@item.BookingId" class="font-weight-bold text-dark">
                                            #HH-@item.BookingId.ToString("D5")
                                        </a>
                                    </td>
                                    <td>
                                        <span class="font-weight-bold text-success" style="font-size: 1.05rem;">
                                            +@item.Amount.ToString("N2") EGP
                                        </span>
                                    </td>
                                    <td><span class="badge badge-light border px-2 py-1">@item.PaymentMethod</span></td>
                                    <td>@item.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td class="text-right">
                                        <a asp-action="Details" asp-route-id="@item.PaymentId" class="btn btn-sm btn-outline-secondary">
                                            <i class="icon-eye mr-1"></i> View Receipt
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="icon-credit-card mb-2" style="font-size: 3rem; color: #8d703b;"></i>
                                    <h5 class="font-weight-bold text-dark mt-2" style="font-family: 'Playfair Display', Georgia, serif;">No Payment Records</h5>
                                    <p class="mb-0">No payment receipts have been generated for your account yet.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
