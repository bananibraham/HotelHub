@model BLLayer1.ViewModel.PaymentCreateVm

@{
    if (ViewData["Layout"] != null)
    {
        Layout = ViewData["Layout"]?.ToString();
    }
    ViewData["Title"] = "Record Payment";
    bool isAdmin = ViewData["Layout"]?.ToString() == "_AdminLayout" || User.IsInRole("Admin");
}

@if (!isAdmin)
{
    <section class="hero-wrap hero-wrap-2 luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
        <div class="overlay"></div>
        <div class="container">
            <div class="row no-gutters slider-text align-items-end justify-content-center">
                <div class="col-md-9 ftco-animate pb-5 text-center">
                    <p class="breadcrumbs">
                        <span class="mr-2"><a asp-action="Index">Payments <i class="ion-ios-arrow-forward"></i></a></span>
                        <span>Record</span>
                    </p>
                    <h1 class="mb-3 bread">Post Payment</h1>
                </div>
            </div>
        </div>
    </section>
}

<div class="@(isAdmin ? "" : "container py-5")">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="luxury-card p-4 p-md-5">
                <div class="mb-4 pb-3 border-bottom">
                    <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.75rem; letter-spacing: 1px;">Financial Management</span>
                    <h2 class="mb-1 font-weight-bold text-dark" style="font-family: 'Playfair Display', Georgia, serif;">Post Settlement Payment</h2>
                    <p class="text-muted small mb-0">Select an active reservation and record the transaction into the immutability ledger.</p>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="form-group mb-3">
                        <label asp-for="BookingId" class="font-weight-bold small text-muted text-uppercase">Stay Reference <span class="text-danger">*</span></label>
                        <select asp-for="BookingId" asp-items="ViewBag.Bookings" class="form-control luxury-input" id="BookingId">
                            <option value="">-- Select Reservation --</option>
                        </select>
                        <span asp-validation-for="BookingId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6 mb-3">
                            <label asp-for="Amount" class="font-weight-bold small text-muted text-uppercase">Settlement Amount (EGP) <span class="text-danger">*</span></label>
                            <input asp-for="Amount" class="form-control luxury-input" type="number" min="0.01" step="0.01" placeholder="0.00" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="form-group col-md-6 mb-3">
                            <label asp-for="PaymentMethod" class="font-weight-bold small text-muted text-uppercase">Payment Channel <span class="text-danger">*</span></label>
                            <select asp-for="PaymentMethod" class="form-control luxury-input">
                                <option value="">-- Select Method --</option>
                                <option value="Cash">Cash (Front Desk)</option>
                                <option value="Credit Card">Credit Card</option>
                                <option value="Debit Card">Debit Card</option>
                                <option value="Bank Transfer">Bank Wire Transfer</option>
                                <option value="Online">Online Gateway</option>
                            </select>
                            <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6 mb-3">
                            <label asp-for="PaymentDate" class="font-weight-bold small text-muted text-uppercase">Posting Timestamp</label>
                            <input asp-for="PaymentDate" type="datetime-local" class="form-control luxury-input" />
                            <span asp-validation-for="PaymentDate" class="text-danger small"></span>
                        </div>

                        <div class="form-group col-md-6 mb-3">
                            <label asp-for="TransactionId" class="font-weight-bold small text-muted text-uppercase">Reference / Auth Code</label>
                            <input asp-for="TransactionId" class="form-control luxury-input" placeholder="e.g. TXN-2026-XXXX" />
                            <span asp-validation-for="TransactionId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Notes" class="font-weight-bold small text-muted text-uppercase">Ledger Remarks / Staff Notes</label>
                        <textarea asp-for="Notes" class="form-control luxury-input" rows="3" style="height: auto;" placeholder="Optional transaction context or terminal approval code..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-luxury-outline">
                            <i class="icon-arrow-left mr-1"></i> Back to Payments
                        </a>
                        <button type="submit" class="btn btn-luxury-gold px-4">
                            <i class="icon-check mr-1"></i> Post Payment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}