@model BLLayer1.ViewModel.PaymentCreateVm

@{
    ViewData["Title"] = "Create Payment";
}

<section class="hero-wrap hero-wrap-2"
         style="background-image: url('@Url.Content("~/images/bg_1.jpg")');"
         data-stellar-background-ratio="0.5">

    <div class="overlay"></div>

    <div class="container">
        <div class="row no-gutters slider-text align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate pb-5 text-center">

                <p class="breadcrumbs">
                    <span class="mr-2">
                        <a asp-action="Index">
                            Payments
                            <i class="ion-ios-arrow-forward"></i>
                        </a>
                    </span>

                    <span>Create</span>
                </p>

                <h1 class="mb-3 bread">Create Payment</h1>

            </div>
        </div>
    </div>
</section>

<section class="ftco-section bg-light">
    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4 p-md-5">

                        <div class="text-center mb-4">
                            <div class="mb-3">
                                <i class="icon-credit-card"
                                   style="font-size:45px;color:#8d703b;"></i>
                            </div>

                            <span class="subheading">
                                Financial Management
                            </span>

                            <h2 class="mb-2">
                                Record New Payment
                            </h2>

                            <p class="text-muted">
                                Select a booking and enter the payment details.
                            </p>
                        </div>

                        <form asp-action="Create" method="post">

                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger"
                                 role="alert">
                            </div>

                            <div class="form-group">
                                <label asp-for="BookingId">
                                    Booking
                                </label>

                                <select asp-for="BookingId"
                                        asp-items="ViewBag.Bookings"
                                        class="form-control"
                                        id="BookingId">

                                    <option value="">
                                        -- Select Booking --
                                    </option>

                                </select>

                                <span asp-validation-for="BookingId"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="form-row">

                                <div class="form-group col-md-6">

                                    <label asp-for="Amount">
                                        Amount
                                    </label>

                                    <div class="input-group">

                                        <input asp-for="Amount"
                                               class="form-control"
                                               type="number"
                                               min="0.01"
                                               step="0.01"
                                               placeholder="0.00" />

                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                EGP
                                            </span>
                                        </div>

                                    </div>

                                    <span asp-validation-for="Amount"
                                          class="text-danger">
                                    </span>

                                </div>

                                <div class="form-group col-md-6">

                                    <label asp-for="PaymentMethod">
                                        Payment Method
                                    </label>

                                    <select asp-for="PaymentMethod"
                                            class="form-control">

                                        <option value="">
                                            -- Select Method --
                                        </option>

                                        <option value="Cash">
                                            Cash
                                        </option>

                                        <option value="Credit Card">
                                            Credit Card
                                        </option>

                                        <option value="Debit Card">
                                            Debit Card
                                        </option>

                                        <option value="Bank Transfer">
                                            Bank Transfer
                                        </option>

                                        <option value="Online">
                                            Online
                                        </option>

                                    </select>

                                    <span asp-validation-for="PaymentMethod"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                            <div class="form-group">

                                <label asp-for="PaymentDate">
                                    Payment Date
                                </label>

                                <input asp-for="PaymentDate"
                                       type="datetime-local"
                                       class="form-control" />

                                <span asp-validation-for="PaymentDate"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="form-group">

                                <label asp-for="TransactionId">
                                    Transaction ID
                                    <span class="text-muted">
                                        (Optional)
                                    </span>
                                </label>

                                <input asp-for="TransactionId"
                                       class="form-control"
                                       placeholder="Enter transaction reference" />

                                <span asp-validation-for="TransactionId"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="form-group">

                                <label asp-for="Notes">
                                    Notes
                                    <span class="text-muted">
                                        (Optional)
                                    </span>
                                </label>

                                <textarea asp-for="Notes"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Add any additional notes..."></textarea>

                                <span asp-validation-for="Notes"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-4">

                                <a asp-action="Index"
                                   class="btn btn-outline-secondary px-4 py-3">
                                    <i class="icon-arrow-left mr-2"></i>
                                    Back
                                </a>

                                <button type="submit"
                                        class="btn btn-primary px-4 py-3">
                                    <i class="icon-check mr-2"></i>
                                    Create Payment
                                </button>

                            </div>

                        </form>

                    </div>
                </div>

            </div>
        </div>

    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}