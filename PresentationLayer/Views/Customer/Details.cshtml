@model BLLayer1.ViewModel.CustomerVM

@{
    if (ViewData["Layout"] != null)
    {
        Layout = ViewData["Layout"]?.ToString();
    }
    ViewData["Title"] = $"Resident {Model.FullName}";
    bool isAdmin = ViewData["Layout"]?.ToString() == "_AdminLayout" || User.IsInRole("Admin");
}

@if (!isAdmin)
{
    <section class="hero-wrap hero-wrap-2 luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
        <div class="overlay"></div>
        <div class="container">
            <div class="row no-gutters slider-text align-items-end justify-content-center">
                <div class="col-md-9 ftco-animate pb-5 text-center">
                    <p class="breadcrumbs">
                        <span class="mr-2"><a asp-action="Index">Guests <i class="ion-ios-arrow-forward"></i></a></span>
                        <span>@Model.FullName</span>
                    </p>
                    <h1 class="mb-3 bread">Resident Dossier</h1>
                </div>
            </div>
        </div>
    </section>
}

<div class="@(isAdmin ? "" : "container py-5")">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="luxury-card p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 pb-3 border-bottom">
                    <div class="d-flex align-items-center">
                        <div class="mr-3 text-white rounded-circle d-flex align-items-center justify-content-center font-weight-bold shadow-sm"
                             style="width: 50px; height: 50px; background: linear-gradient(135deg, #c5a880, #8d703b); font-size: 1.3rem;">
                            @(Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "G")
                        </div>
                        <div>
                            <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.75rem; letter-spacing: 1px;">Resident Dossier</span>
                            <h2 class="mb-0 font-weight-bold text-dark" style="font-family: 'Playfair Display', Georgia, serif;">@Model.FullName</h2>
                        </div>
                    </div>
                    <div class="mt-2 mt-md-0">
                        <span class="badge-luxury-confirmed font-weight-bold">
                            <i class="icon-check-circle mr-1"></i> Active Resident
                        </span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small d-block font-weight-bold text-uppercase">Email Contact</span>
                            <a href="mailto:@Model.Email" class="font-weight-bold text-dark d-block mt-1">@Model.Email</a>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small d-block font-weight-bold text-uppercase">Mobile Contact</span>
                            <a href="tel:@Model.Phone" class="font-weight-bold text-primary d-block mt-1">@Model.Phone</a>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small d-block font-weight-bold text-uppercase">National Identification / Passport</span>
                            <span class="font-weight-bold text-dark d-block mt-1">
                                <code>@(string.IsNullOrWhiteSpace(Model.NationalId) ? "Unregistered" : Model.NationalId)</code>
                            </span>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small d-block font-weight-bold text-uppercase">Residence Region</span>
                            <span class="font-weight-bold text-dark d-block mt-1">
                                @(string.IsNullOrWhiteSpace(Model.City) ? "" : Model.City + ", ")@(string.IsNullOrWhiteSpace(Model.Country) ? "Egypt" : Model.Country)
                            </span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Address))
                {
                    <div class="p-3 border rounded mb-4">
                        <span class="text-muted small d-block font-weight-bold text-uppercase mb-1">Registered Street Address</span>
                        <p class="mb-0 text-dark">@Model.Address</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-luxury-outline">
                        <i class="icon-arrow-left mr-1"></i> Back to Guests
                    </a>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-luxury-gold mr-2">
                            <i class="icon-pencil mr-1"></i> Edit Profile
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete" asp-route-id="@Model.CustomerId" class="btn btn-outline-danger">
                                <i class="icon-trash mr-1"></i> Delete
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>