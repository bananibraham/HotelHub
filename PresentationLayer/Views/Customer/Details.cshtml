@model BLLayer1.ViewModel.CustomerVM

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-user"></i> Customer Details
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Personal Information -->
                    <h5 class="text-primary mb-3">
                        <i class="fas fa-id-card"></i> Personal Information
                    </h5>
                    
                    <dl class="row">
                        <dt class="col-sm-3 fw-bold">Customer ID</dt>
                        <dd class="col-sm-9"><span class="badge bg-secondary">#@Model.CustomerId</span></dd>

                        <dt class="col-sm-3 fw-bold">Full Name</dt>
                        <dd class="col-sm-9">@Model.FullName</dd>

                        <dt class="col-sm-3 fw-bold">National ID</dt>
                        <dd class="col-sm-9"><code>@Model.NationalId</code></dd>

                        <dt class="col-sm-3 fw-bold">Email Address</dt>
                        <dd class="col-sm-9">
                            <a href="mailto:@Model.Email">
                                <i class="fas fa-envelope"></i> @Model.Email
                            </a>
                        </dd>

                        <dt class="col-sm-3 fw-bold">Phone Number</dt>
                        <dd class="col-sm-9">
                            <a href="tel:@Model.Phone">
                                <i class="fas fa-phone"></i> @Model.Phone
                            </a>
                        </dd>
                    </dl>

                    <!-- Address Information -->
                    <h5 class="text-primary mb-3 mt-4">
                        <i class="fas fa-map-marker-alt"></i> Address Information
                    </h5>
                    
                    <dl class="row">
                        <dt class="col-sm-3 fw-bold">Address</dt>
                        <dd class="col-sm-9">@Model.Address</dd>

                        <dt class="col-sm-3 fw-bold">City</dt>
                        <dd class="col-sm-9">@Model.City</dd>

                        <dt class="col-sm-3 fw-bold">Country</dt>
                        <dd class="col-sm-9">@Model.Country</dd>
                    </dl>

                    <!-- Status -->
                    <h5 class="text-primary mb-3 mt-4">
                        <i class="fas fa-info-circle"></i> Status
                    </h5>
                    
                    <dl class="row">
                        <dt class="col-sm-3 fw-bold">Account Status</dt>
                        <dd class="col-sm-9">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check"></i> Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    <i class="fas fa-times"></i> Inactive
                                </span>
                            }
                        </dd>
                    </dl>

                    <hr />

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-warning">
                                <i class="fas fa-edit"></i> Edit Customer
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.CustomerId" class="btn btn-danger">
                                <i class="fas fa-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>