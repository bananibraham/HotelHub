@model BLLayer1.ViewModel.CustomerVM

@{
    if (ViewData["Layout"] != null)
    {
        Layout = ViewData["Layout"]?.ToString();
    }
    ViewData["Title"] = "Register Guest Profile";
    bool isAdmin = ViewData["Layout"]?.ToString() == "_AdminLayout" || User.IsInRole("Admin");
}

@if (!isAdmin)
{
    <section class="hero-wrap hero-wrap-2 luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
        <div class="overlay"></div>
        <div class="container">
            <div class="row no-gutters slider-text align-items-end justify-content-center">
                <div class="col-md-9 ftco-animate pb-5 text-center">
                    <p class="breadcrumbs">
                        <span class="mr-2"><a asp-action="Index">Guests <i class="ion-ios-arrow-forward"></i></a></span>
                        <span>Register</span>
                    </p>
                    <h1 class="mb-3 bread">New Resident Registration</h1>
                </div>
            </div>
        </div>
    </section>
}

<div class="@(isAdmin ? "" : "container py-5")">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="luxury-card p-4 p-md-5">
                <div class="mb-4 pb-3 border-bottom">
                    <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.75rem; letter-spacing: 1px;">Guest Relations &amp; Front Desk</span>
                    <h2 class="mb-1 font-weight-bold text-dark" style="font-family: 'Playfair Display', Georgia, serif;">Register New Guest</h2>
                    <p class="text-muted small mb-0">Create a verified resident profile for reservations, in-room billing, and loyalty perks.</p>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FullName" class="font-weight-bold small text-muted text-uppercase">Full Legal Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control luxury-input" placeholder="e.g. Omar Abdelrahman" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="font-weight-bold small text-muted text-uppercase">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control luxury-input" type="email" placeholder="guest@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="font-weight-bold small text-muted text-uppercase">Mobile Contact <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control luxury-input" placeholder="01012345678" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="NationalId" class="font-weight-bold small text-muted text-uppercase">National ID / Passport Number</label>
                            <input asp-for="NationalId" class="form-control luxury-input" placeholder="14-digit National ID" maxlength="14" />
                            <span asp-validation-for="NationalId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Address" class="font-weight-bold small text-muted text-uppercase">Residential Address</label>
                        <input asp-for="Address" class="form-control luxury-input" placeholder="Street name, district, apartment" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3">
                            <label asp-for="City" class="font-weight-bold small text-muted text-uppercase">City</label>
                            <input asp-for="City" class="form-control luxury-input" placeholder="e.g. Cairo" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Country" class="font-weight-bold small text-muted text-uppercase">Country</label>
                            <input asp-for="Country" class="form-control luxury-input" placeholder="e.g. Egypt" />
                            <span asp-validation-for="Country" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-luxury-outline">
                            <i class="icon-arrow-left mr-1"></i> Back to Guest Directory
                        </a>
                        <button type="submit" class="btn btn-luxury-gold px-4">
                            <i class="icon-check mr-1"></i> Register Profile
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}