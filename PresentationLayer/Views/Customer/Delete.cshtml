@model BLLayer1.ViewModel.CustomerVM

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i> Confirm Delete
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <h5 class="alert-heading">
                            <i class="fas fa-exclamation-circle"></i> Warning!
                        </h5>
                        <p class="mb-0">
                            Are you sure you want to delete this customer? This action will mark the customer as inactive.
                        </p>
                    </div>

                    <h5 class="text-danger mb-3">Customer Information</h5>
                    
                    <dl class="row">
                        <dt class="col-sm-3 fw-bold">Customer ID</dt>
                        <dd class="col-sm-9"><span class="badge bg-secondary">#@Model.CustomerId</span></dd>

                        <dt class="col-sm-3 fw-bold">Full Name</dt>
                        <dd class="col-sm-9"><strong>@Model.FullName</strong></dd>

                        <dt class="col-sm-3 fw-bold">Email</dt>
                        <dd class="col-sm-9">@Model.Email</dd>

                        <dt class="col-sm-3 fw-bold">Phone</dt>
                        <dd class="col-sm-9">@Model.Phone</dd>

                        <dt class="col-sm-3 fw-bold">National ID</dt>
                        <dd class="col-sm-9"><code>@Model.NationalId</code></dd>
                    </dl>

                    <hr />

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="CustomerId" />
                        
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="fas fa-trash"></i> Yes, Delete Customer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>