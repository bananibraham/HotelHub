@model BLLayer1.ViewModel.CustomerVM

@{
    if (ViewData["Layout"] != null)
    {
        Layout = ViewData["Layout"]?.ToString();
    }
    ViewData["Title"] = $"Delete Resident {Model.FullName}";
    bool isAdmin = ViewData["Layout"]?.ToString() == "_AdminLayout" || User.IsInRole("Admin");
}

@if (!isAdmin)
{
    <section class="hero-wrap hero-wrap-2 luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
        <div class="overlay"></div>
        <div class="container">
            <div class="row no-gutters slider-text align-items-end justify-content-center">
                <div class="col-md-9 ftco-animate pb-5 text-center">
                    <p class="breadcrumbs">
                        <span class="mr-2"><a asp-action="Index">Guests <i class="ion-ios-arrow-forward"></i></a></span>
                        <span>Delete</span>
                    </p>
                    <h1 class="mb-3 bread">Deactivate Resident</h1>
                </div>
            </div>
        </div>
    </section>
}

<div class="@(isAdmin ? "" : "container py-5")">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="luxury-card p-4 p-md-5 border-danger">
                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="icon-trash text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <span class="text-uppercase text-danger font-weight-bold" style="font-size: 0.75rem; letter-spacing: 1px;">Destructive Action</span>
                    <h2 class="mb-2 font-weight-bold text-dark" style="font-family: 'Playfair Display', Georgia, serif;">Remove Resident @Model.FullName?</h2>
                    <p class="text-muted small">Are you sure you want to deactivate and remove this guest profile from the resort database?</p>
                </div>

                <div class="p-4 bg-light rounded mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted small text-uppercase">Full Name</dt>
                        <dd class="col-sm-8 font-weight-bold text-dark">@Model.FullName</dd>

                        <dt class="col-sm-4 text-muted small text-uppercase">Email</dt>
                        <dd class="col-sm-8 text-dark">@Model.Email</dd>

                        <dt class="col-sm-4 text-muted small text-uppercase">Phone</dt>
                        <dd class="col-sm-8 text-dark">@Model.Phone</dd>

                        <dt class="col-sm-4 text-muted small text-uppercase">National ID</dt>
                        <dd class="col-sm-8 font-weight-bold text-dark">
                            <code>@(string.IsNullOrWhiteSpace(Model.NationalId) ? "None" : Model.NationalId)</code>
                        </dd>
                    </dl>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.CustomerId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.CustomerId" />
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-luxury-outline">
                            <i class="icon-arrow-left mr-1"></i> Cancel &amp; Return
                        </a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="icon-trash mr-1"></i> Confirm Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>