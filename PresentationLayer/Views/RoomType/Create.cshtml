@model DataAccessLayer.Models.RoomType

@{
    if (ViewData["Layout"] != null)
    {
        Layout = ViewData["Layout"]?.ToString();
    }
    ViewData["Title"] = "Create Room Type";
    bool isAdmin = ViewData["Layout"]?.ToString() == "_AdminLayout" || User.IsInRole("Admin");
}

@if (!isAdmin)
{
    <section class="hero-wrap hero-wrap-2 luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
        <div class="overlay"></div>
        <div class="container">
            <div class="row no-gutters slider-text align-items-end justify-content-center">
                <div class="col-md-9 ftco-animate pb-5 text-center">
                    <p class="breadcrumbs">
                        <span class="mr-2"><a asp-action="Index">Room Types <i class="ion-ios-arrow-forward"></i></a></span>
                        <span>Create</span>
                    </p>
                    <h1 class="mb-3 bread">New Room Category</h1>
                </div>
            </div>
        </div>
    </section>
}

<div class="@(isAdmin ? "" : "container py-5")">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="luxury-card p-4 p-md-5">
                <div class="mb-4 pb-3 border-bottom">
                    <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.75rem; letter-spacing: 1px;">Resort Inventory Setup</span>
                    <h2 class="mb-1 font-weight-bold text-dark" style="font-family: 'Playfair Display', Georgia, serif;">Create Room Type</h2>
                    <p class="text-muted small mb-0">Define a new suite tier with standard rates, guest capacities, and room features.</p>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-md-7 mb-3">
                            <label asp-for="Name" class="font-weight-bold small text-muted text-uppercase">Category Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control luxury-input" placeholder="e.g. Royal Ocean Suite" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5 mb-3">
                            <label asp-for="PricePerNight" class="font-weight-bold small text-muted text-uppercase">Tariff / Night (EGP) <span class="text-danger">*</span></label>
                            <input asp-for="PricePerNight" type="number" step="0.01" class="form-control luxury-input" placeholder="3500.00" />
                            <span asp-validation-for="PricePerNight" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="font-weight-bold small text-muted text-uppercase">Description &amp; Highlights</label>
                        <textarea asp-for="Description" class="form-control luxury-input" rows="3" style="height: auto;" placeholder="Summarize ocean views, balcony, bed setup, and luxury amenities..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Capacity" class="font-weight-bold small text-muted text-uppercase">Total Capacity <span class="text-danger">*</span></label>
                            <input asp-for="Capacity" type="number" min="1" max="10" class="form-control luxury-input" />
                            <span asp-validation-for="Capacity" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="MaxAdults" class="font-weight-bold small text-muted text-uppercase">Max Adults <span class="text-danger">*</span></label>
                            <input asp-for="MaxAdults" type="number" min="1" max="8" class="form-control luxury-input" />
                            <span asp-validation-for="MaxAdults" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="MaxChildren" class="font-weight-bold small text-muted text-uppercase">Max Children</label>
                            <input asp-for="MaxChildren" type="number" min="0" max="6" class="form-control luxury-input" />
                            <span asp-validation-for="MaxChildren" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <div class="custom-control custom-checkbox">
                            <input asp-for="IsActive" class="custom-control-input" id="isActiveCheck" checked />
                            <label class="custom-control-label font-weight-bold text-dark" for="isActiveCheck">
                                Enable and display this category on public reservation catalogs
                            </label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-luxury-outline">
                            <i class="icon-arrow-left mr-1"></i> Back to Room Types
                        </a>
                        <button type="submit" class="btn btn-luxury-gold px-4">
                            <i class="icon-check mr-1"></i> Create Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}