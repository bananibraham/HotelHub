@model DataAccessLayer.Models.RoomType

@{
    ViewData["Title"] = "Room Type Details";
}

<h1>Room Type Details</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Price Per Night</dt>
    <dd class="col-sm-9">@Model.PricePerNight</dd>

    <dt class="col-sm-3">Capacity</dt>
    <dd class="col-sm-9">@Model.Capacity</dd>

    <dt class="col-sm-3">Max Adults</dt>
    <dd class="col-sm-9">@Model.MaxAdults</dd>

    <dt class="col-sm-3">Max Children</dt>
    <dd class="col-sm-9">@Model.MaxChildren</dd>

    <dt class="col-sm-3">Created At</dt>
    <dd class="col-sm-9">@Model.CreatedAt</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @(Model.IsActive ? "Active" : "Inactive")
    </dd>

</dl>

<a asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-warning">
    Edit
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back to List
</a>