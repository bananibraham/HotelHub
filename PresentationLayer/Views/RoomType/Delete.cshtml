@model DataAccessLayer.Models.RoomType

@{
    if (ViewData["Layout"] != null)
    {
        Layout = ViewData["Layout"]?.ToString();
    }
    ViewData["Title"] = $"Delete {Model.Name}";
    bool isAdmin = ViewData["Layout"]?.ToString() == "_AdminLayout" || User.IsInRole("Admin");
}

@if (!isAdmin)
{
    <section class="hero-wrap hero-wrap-2 luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
        <div class="overlay"></div>
        <div class="container">
            <div class="row no-gutters slider-text align-items-end justify-content-center">
                <div class="col-md-9 ftco-animate pb-5 text-center">
                    <p class="breadcrumbs">
                        <span class="mr-2"><a asp-action="Index">Room Types <i class="ion-ios-arrow-forward"></i></a></span>
                        <span>Delete</span>
                    </p>
                    <h1 class="mb-3 bread">Decommission Category</h1>
                </div>
            </div>
        </div>
    </section>
}

<div class="@(isAdmin ? "" : "container py-5")">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="luxury-card p-4 p-md-5 border-danger">
                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="icon-trash text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <span class="text-uppercase text-danger font-weight-bold" style="font-size: 0.75rem; letter-spacing: 1px;">Destructive Action</span>
                    <h2 class="mb-2 font-weight-bold text-dark" style="font-family: 'Playfair Display', Georgia, serif;">Remove Category @Model.Name?</h2>
                    <p class="text-muted small">Are you sure you want to delete this room type? Rooms currently categorized under this tier must be reclassified first.</p>
                </div>

                <div class="p-4 bg-light rounded mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted small text-uppercase">Category Name</dt>
                        <dd class="col-sm-8 font-weight-bold text-dark">@Model.Name</dd>

                        <dt class="col-sm-4 text-muted small text-uppercase">Nightly Rate</dt>
                        <dd class="col-sm-8 font-weight-bold" style="color: #8d703b;">@Model.PricePerNight.ToString("N2") EGP</dd>

                        <dt class="col-sm-4 text-muted small text-uppercase">Capacity</dt>
                        <dd class="col-sm-8 text-dark">@Model.Capacity Guests (@Model.MaxAdults Adults, @Model.MaxChildren Children)</dd>

                        <dt class="col-sm-4 text-muted small text-uppercase">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge badge-light border font-weight-bold">@(Model.IsActive ? "Active" : "Inactive")</span>
                        </dd>
                    </dl>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-luxury-outline">
                            <i class="icon-arrow-left mr-1"></i> Cancel &amp; Return
                        </a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="icon-trash mr-1"></i> Confirm Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>