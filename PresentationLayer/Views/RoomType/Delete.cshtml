@model DataAccessLayer.Models.RoomType

@{
    ViewData["Title"] = "Delete Room Type";
}

<h1>Delete Room Type</h1>

<h4>Are you sure you want to delete this room type?</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Price Per Night</dt>
    <dd class="col-sm-9">@Model.PricePerNight</dd>

    <dt class="col-sm-3">Capacity</dt>
    <dd class="col-sm-9">@Model.Capacity</dd>

    <dt class="col-sm-3">Max Adults</dt>
    <dd class="col-sm-9">@Model.MaxAdults</dd>

    <dt class="col-sm-3">Max Children</dt>
    <dd class="col-sm-9">@Model.MaxChildren</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @(Model.IsActive ? "Active" : "Inactive")
    </dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden" name="id" value="@Model.Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>