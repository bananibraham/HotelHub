@model IEnumerable<DataAccessLayer.Models.RoomType>

@{
    if (ViewData["Layout"] != null)
    {
        Layout = ViewData["Layout"]?.ToString();
    }
    ViewData["Title"] = "Room Classifications";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <span class="text-uppercase small font-weight-bold" style="color: #8d703b; letter-spacing: 1px;">Resort Inventory</span>
            <h2 class="font-weight-bold mb-1 text-dark" style="font-family: 'Playfair Display', Georgia, serif;">
                Room Classifications &amp; Rates
            </h2>
            <p class="text-muted small mb-0">Base pricing per night in Egyptian Pounds (EGP) and guest occupancy capacities.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div class="mt-3 mt-md-0">
                <a asp-action="Create" class="btn-luxury-gold">
                    <i class="icon-plus mr-1"></i> Add Room Classification
                </a>
            </div>
        }
    </div>

<div class="luxury-card">
    <div class="table-responsive">
        <table class="table table-luxury mb-0">
            <thead>
                <tr>
                    <th>Category Name</th>
                    <th>Description</th>
                    <th>Base Rate / Night</th>
                    <th>Capacity</th>
                    <th>Adults / Children</th>
                    <th>Status</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong class="text-dark" style="font-size: 1.05rem;">@item.Name</strong>
                            </td>
                            <td>
                                <span class="small text-muted" style="max-width: 250px; display: inline-block;">@item.Description</span>
                            </td>
                            <td>
                                <span class="font-weight-bold" style="color: #8d703b; font-size: 1.1rem; font-family: 'Playfair Display', Georgia, serif;">
                                    @item.PricePerNight.ToString("N0") EGP
                                </span>
                            </td>
                            <td>
                                <span class="badge badge-light border px-2 py-1">@item.Capacity Persons</span>
                            </td>
                            <td>
                                <small class="text-muted">Adults: @item.MaxAdults &bull; Children: @item.MaxChildren</small>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge-luxury-confirmed">Active</span>
                                }
                                else
                                {
                                    <span class="badge-luxury-checkedout">Inactive</span>
                                }
                            </td>
                            <td class="text-right">
                                <div class="d-inline-flex" style="gap: 4px;">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="icon-eye"></i> Details
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="icon-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                            <i class="icon-trash"></i> Delete
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="icon-th-list mb-2" style="font-size: 3rem; color: #8d703b;"></i>
                            <p class="mb-0">No room classifications configured.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>