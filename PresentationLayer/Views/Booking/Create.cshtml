@model BLLayer1.ViewModel.BookingVM

@{
    if (ViewData["Layout"] != null)
    {
        Layout = ViewData["Layout"]?.ToString();
    }
    ViewData["Title"] = "New Walk-In Reservation";
    bool isAdmin = ViewData["Layout"]?.ToString() == "_AdminLayout" || User.IsInRole("Admin");
}

@if (!isAdmin)
{
    <section class="hero-wrap hero-wrap-2 luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
        <div class="overlay"></div>
        <div class="container">
            <div class="row no-gutters slider-text align-items-end justify-content-center">
                <div class="col-md-9 ftco-animate pb-5 text-center">
                    <p class="breadcrumbs">
                        <span class="mr-2"><a asp-area="" asp-controller="Home" asp-action="Index">Home <i class="ion-ios-arrow-forward"></i></a></span> 
                        <span class="mr-2"><a asp-action="Index">Bookings <i class="ion-ios-arrow-forward"></i></a></span> 
                        <span>New Walk-in</span>
                    </p>
                    <h1 class="mb-3 bread">New Walk-In Reservation</h1>
                </div>
            </div>
        </div>
    </section>
}

<div class="@(isAdmin ? "" : "container py-5")">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="luxury-card p-4 p-md-5">
                <div class="mb-4 pb-3 border-bottom">
                    <span class="text-uppercase text-muted font-weight-bold" style="font-size: 0.75rem; letter-spacing: 1px;">Front Desk Operations</span>
                    <h2 class="mb-1 font-weight-bold text-dark" style="font-family: 'Playfair Display', Georgia, serif;">Create Walk-In Reservation</h2>
                    <p class="text-muted small mb-0">Select verified resident, allocate suite from live inventory, and confirm stay duration.</p>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Customer Selection -->
                    <div class="form-group mb-3">
                        <label asp-for="CustomerId" class="font-weight-bold small text-muted text-uppercase">Resident / Guest Profile <span class="text-danger">*</span></label>
                        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-control luxury-input">
                            <option value="">-- Select Guest --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <!-- Room Selection -->
                    <div class="form-group mb-3">
                        <label asp-for="RoomId" class="font-weight-bold small text-muted text-uppercase">Allocated Room / Suite <span class="text-danger">*</span></label>
                        <select asp-for="RoomId" asp-items="ViewBag.Rooms" class="form-control luxury-input">
                            <option value="">-- Select Available Room --</option>
                        </select>
                        <span asp-validation-for="RoomId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <!-- Check-in Date -->
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="CheckInDate" class="font-weight-bold small text-muted text-uppercase">Check-In Date <span class="text-danger">*</span></label>
                            <input asp-for="CheckInDate" type="date" class="form-control luxury-input" />
                            <span asp-validation-for="CheckInDate" class="text-danger small"></span>
                        </div>

                        <!-- Check-out Date -->
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="CheckOutDate" class="font-weight-bold small text-muted text-uppercase">Check-Out Date <span class="text-danger">*</span></label>
                            <input asp-for="CheckOutDate" type="date" class="form-control luxury-input" />
                            <span asp-validation-for="CheckOutDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Status Selection -->
                    <div class="form-group mb-4">
                        <label asp-for="Status" class="font-weight-bold small text-muted text-uppercase">Initial Status</label>
                        <select asp-for="Status" asp-items="ViewBag.Statuses" class="form-control luxury-input">
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <!-- Submit Buttons -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-luxury-outline">
                            <i class="icon-arrow-left mr-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-luxury-gold px-4">
                            <i class="icon-check mr-1"></i> Create Reservation
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
