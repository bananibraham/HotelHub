@model IEnumerable<BLLayer1.ViewModel.BookingVM>

@{
    if (ViewData["Layout"] != null)
    {
        Layout = ViewData["Layout"]?.ToString();
    }
    ViewData["Title"] = "Bookings Management";
    var isAdmin = ViewData["Layout"]?.ToString() == "_AdminLayout";
}

@if (!isAdmin)
{
    <!-- HERO BANNER -->
    <section class="luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
        <div class="overlay"></div>
        <div class="container text-center position-relative" style="z-index: 2;">
            <p class="breadcrumbs mb-2"><span class="mr-2"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></span> <span>Bookings</span></p>
            <h1 class="bread mb-2">Reservation Management</h1>
            <p class="subtitle">Comprehensive front-desk and administrative control of resort reservations.</p>
        </div>
    </section>
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <span class="text-uppercase small font-weight-bold" style="color: #8d703b; letter-spacing: 1px;">Front Desk Operations</span>
            <h2 class="font-weight-bold text-dark mt-1 mb-0" style="font-family: 'Playfair Display', Georgia, serif;">
                Hotel Reservations
            </h2>
            <p class="text-muted small mb-0">Review guest bookings, process stay arrivals, departures, and walk-in requests.</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="Create" class="btn-luxury-gold">
                <i class="icon-plus mr-2"></i> New Walk-In Booking
            </a>
        </div>
    </div>

    <div class="luxury-card mb-4">
        <div class="table-responsive">
            <table class="table table-luxury mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Guest Name</th>
                        <th>Room Unit</th>
                        <th>Check-In</th>
                        <th>Check-Out</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th class="text-center" style="min-width: 260px;">Actions</th>
                    </tr>
                </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="icon-calendar-o" style="font-size: 2.5rem;"></i>
                                    <p class="mt-2 mb-0">No bookings found. Click "New Booking" to create your first reservation.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="font-weight-bold">#@item.BookingId</td>
                                    <td>
                                        <div class="font-weight-bold text-dark">@item.CustomerName</div>
                                        @if (!string.IsNullOrEmpty(item.CustomerEmail))
                                        {
                                            <div class="small text-muted">@item.CustomerEmail</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge badge-secondary px-2 py-1">Room @item.RoomNumber</span>
                                        <div class="small text-muted">@item.RoomType</div>
                                    </td>
                                    <td>@item.CheckInDate.ToString("yyyy-MM-dd")</td>
                                    <td>@item.CheckOutDate.ToString("yyyy-MM-dd")</td>
                                    <td class="font-weight-bold text-success">@item.TotalPrice.ToString("N2") EGP</td>
                                    <td>
                                        @switch (item.Status)
                                        {
                                            case "Confirmed":
                                                <span class="badge badge-success px-3 py-1">Confirmed</span>
                                                break;
                                            case "CheckedIn":
                                                <span class="badge badge-info px-3 py-1">Checked-In</span>
                                                break;
                                            case "CheckedOut":
                                                <span class="badge badge-dark px-3 py-1">Checked-Out</span>
                                                break;
                                            case "Cancelled":
                                                <span class="badge badge-danger px-3 py-1">Cancelled</span>
                                                break;
                                            default:
                                                <span class="badge badge-warning px-3 py-1 text-dark">@item.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center align-middle">
                                        <div class="booking-actions">
                                            @if (item.Status == "Pending" || item.Status == "Confirmed")
                                            {
                                                <form asp-action="CheckIn" asp-route-id="@item.BookingId" method="post" class="d-inline" onsubmit="return confirm('Confirm check-in for Guest @item.CustomerName (Booking #@item.BookingId)?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="action-btn action-checkin" title="Check In Guest">
                                                        <span class="icon-sign-in"></span> Check-In
                                                    </button>
                                                </form>
                                            }
                                            @if (item.Status == "CheckedIn")
                                            {
                                                <form asp-action="CheckOut" asp-route-id="@item.BookingId" method="post" class="d-inline" onsubmit="return confirm('Confirm check-out for Guest @item.CustomerName (Booking #@item.BookingId)?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="action-btn action-checkout" title="Check Out Guest">
                                                        <span class="icon-sign-out"></span> Check-Out
                                                    </button>
                                                </form>
                                            }
                                            <a asp-action="Details" asp-route-id="@item.BookingId" class="action-btn action-details" title="View Details">
                                                <span class="icon-eye"></span> Details
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.BookingId" class="action-btn action-edit" title="Edit Booking">
                                                <span class="icon-pencil"></span> Edit
                                            </a>
                                            @if (item.Status != "Cancelled" && item.Status != "CheckedOut")
                                            {
                                                <form asp-action="Cancel" asp-route-id="@item.BookingId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel Booking #@item.BookingId?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="action-btn action-cancel" title="Cancel Booking">
                                                        <span class="icon-close"></span> Cancel
                                                    </button>
                                                </form>
                                            }
                                            <a asp-action="Delete" asp-route-id="@item.BookingId" class="action-btn action-delete" title="Delete Booking">
                                                <span class="icon-trash"></span> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<style>
    /* Booking Actions — scoped styling */
    .booking-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 5px 12px;
        font-size: 0.78rem;
        font-weight: 600;
        line-height: 1.4;
        border-radius: 5px;
        border: 1.5px solid transparent;
        background: transparent;
        text-decoration: none !important;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
        letter-spacing: 0.01em;
    }

    .action-btn span[class^="icon-"] {
        font-size: 0.82rem;
    }

    /* Check-In — muted emerald green */
    .action-checkin {
        color: #2e7d32;
        border-color: #2e7d32;
    }
    .action-checkin:hover {
        background: #2e7d32;
        color: #fff;
    }

    /* Check-Out — muted deep purple */
    .action-checkout {
        color: #6a1b9a;
        border-color: #6a1b9a;
    }
    .action-checkout:hover {
        background: #6a1b9a;
        color: #fff;
    }

    /* Details — muted slate blue */
    .action-details {
        color: #5a7d9a;
        border-color: #5a7d9a;
    }
    .action-details:hover {
        background: #5a7d9a;
        color: #fff;
    }

    /* Edit — professional blue */
    .action-edit {
        color: #3a6ea5;
        border-color: #3a6ea5;
    }
    .action-edit:hover {
        background: #3a6ea5;
        color: #fff;
    }

    /* Cancel — muted amber */
    .action-cancel {
        color: #b8860b;
        border-color: #c9972e;
    }
    .action-cancel:hover {
        background: #c9972e;
        color: #fff;
        border-color: #c9972e;
    }

    /* Delete — muted red */
    .action-delete {
        color: #b04a4a;
        border-color: #b04a4a;
    }
    .action-delete:hover {
        background: #b04a4a;
        color: #fff;
    }
</style>
