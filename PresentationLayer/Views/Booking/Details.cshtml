@model BLLayer1.ViewModel.BookingVM

@{
    if (ViewData["Layout"] != null)
    {
        Layout = ViewData["Layout"]?.ToString();
    }
    ViewData["Title"] = $"Reservation #{Model.BookingId} Statement";
    var isAdmin = ViewData["Layout"]?.ToString() == "_AdminLayout";
    int stayNights = Math.Max(1, (Model.CheckOutDate.Date - Model.CheckInDate.Date).Days);
}

@if (!isAdmin)
{
    <!-- HERO BANNER -->
    <section class="luxury-hero" style="background-image: url('@Url.Content("~/images/bg_1.jpg")');">
        <div class="overlay"></div>
        <div class="container text-center position-relative" style="z-index: 2;">
            <p class="breadcrumbs mb-2">
                <span class="mr-2"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></span> 
                <span class="mr-2">&bull;</span>
                <span class="mr-2"><a asp-action="Index">Reservations</a></span> 
                <span class="mr-2">&bull;</span>
                <span class="text-white">Statement</span>
            </p>
            <h1 class="bread mb-2">Reservation Statement</h1>
            <p class="subtitle">Official reservation record, guest itinerary, and payment status.</p>
        </div>
    </section>
}

<section class="ftco-section bg-light py-5">
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
                <i class="icon-check mr-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                <i class="icon-exclamation-triangle mr-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        }

        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-9">
                <div class="luxury-card p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3 flex-wrap">
                        <div>
                            <span class="text-uppercase small font-weight-bold" style="color: #8d703b; letter-spacing: 1px;">Stay Itinerary</span>
                            <h2 class="font-weight-bold mb-0 text-dark" style="font-family: 'Playfair Display', Georgia, serif;">
                                Reservation #HH-@Model.BookingId.ToString("D5")
                            </h2>
                            <small class="text-muted">Booked on @Model.CreatedAt.ToString("MMMM dd, yyyy - hh:mm tt")</small>
                        </div>
                        <div class="mt-2 mt-md-0">
                            @if (Model.Status == "Confirmed")
                            {
                                <span class="badge-luxury-confirmed">Confirmed</span>
                            }
                            else if (Model.Status == "CheckedIn")
                            {
                                <span class="badge-luxury-checkedin">In-House</span>
                            }
                            else if (Model.Status == "CheckedOut")
                            {
                                <span class="badge-luxury-checkedout">Completed</span>
                            }
                            else if (Model.Status == "Cancelled")
                            {
                                <span class="badge-luxury-cancelled">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge-luxury-gold">@Model.Status</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-4">
                        <!-- Guest Information -->
                        <div class="col-md-6 mb-3">
                            <div class="p-3 bg-light rounded border h-100" style="border-radius: 10px !important;">
                                <span class="text-uppercase small font-weight-bold text-muted d-block mb-2" style="letter-spacing: 0.5px;">Guest Profile</span>
                                <p class="mb-1"><strong>Name:</strong> @Model.CustomerName</p>
                                @if (!string.IsNullOrEmpty(Model.CustomerEmail))
                                {
                                    <p class="mb-1"><strong>Email:</strong> @Model.CustomerEmail</p>
                                }
                                @if (!string.IsNullOrEmpty(Model.CustomerPhone))
                                {
                                    <p class="mb-1"><strong>Phone:</strong> @Model.CustomerPhone</p>
                                }
                                <p class="mb-0 text-muted small mt-2">Customer ID: #@Model.CustomerId</p>
                            </div>
                        </div>

                        <!-- Room & Stay Information -->
                        <div class="col-md-6 mb-3">
                            <div class="p-3 bg-light rounded border h-100" style="border-radius: 10px !important;">
                                <span class="text-uppercase small font-weight-bold text-muted d-block mb-2" style="letter-spacing: 0.5px;">Suite &amp; Stay</span>
                                <p class="mb-1"><strong>Allocated Unit:</strong> Room @Model.RoomNumber (@Model.RoomType)</p>
                                <p class="mb-1"><strong>Arrival:</strong> @Model.CheckInDate.ToString("dddd, dd MMMM yyyy") <small class="text-muted">(From 3 PM)</small></p>
                                <p class="mb-1"><strong>Departure:</strong> @Model.CheckOutDate.ToString("dddd, dd MMMM yyyy") <small class="text-muted">(By 12 PM)</small></p>
                                <p class="mb-0"><strong>Stay Length:</strong> @stayNights @(stayNights == 1 ? "Night" : "Nights")</p>
                            </div>
                        </div>
                    </div>

                    <!-- Price & Summary -->
                    <div class="p-4 bg-light rounded border mb-4 d-flex justify-content-between align-items-center flex-wrap" style="border-radius: 10px !important;">
                        <div>
                            <span class="text-muted text-uppercase small font-weight-bold d-block" style="letter-spacing: 0.5px;">Total Reservation Cost</span>
                            <span class="h3 font-weight-bold mb-0" style="color: #8d703b; font-family: 'Playfair Display', Georgia, serif;">
                                @Model.TotalPrice.ToString("N2") EGP
                            </span>
                        </div>
                        <div class="mt-2 mt-md-0">
                            <a asp-controller="Payment" asp-action="Checkout" asp-route-bookingId="@Model.BookingId" class="btn-luxury-gold py-2 px-4">
                                <i class="icon-credit-card mr-2"></i> Payment / Settle
                            </a>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between pt-3 border-top flex-wrap" style="gap: 8px;">
                        <a asp-action="Index" class="btn-luxury-outline">
                            <i class="icon-arrow-left mr-1"></i> Back to Reservations
                        </a>
                        <div class="d-inline-flex flex-wrap" style="gap: 6px;">
                            @if (Model.Status == "Pending" || Model.Status == "Confirmed")
                            {
                                <form asp-action="CheckIn" asp-route-id="@Model.BookingId" method="post" class="d-inline" onsubmit="return confirm('Confirm check-in for this booking?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success px-3">
                                        <i class="icon-sign-in mr-1"></i> Check-In
                                    </button>
                                </form>
                            }
                            @if (Model.Status == "CheckedIn")
                            {
                                <form asp-action="CheckOut" asp-route-id="@Model.BookingId" method="post" class="d-inline" onsubmit="return confirm('Confirm check-out for this booking?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-dark px-3">
                                        <i class="icon-sign-out mr-1"></i> Check-Out
                                    </button>
                                </form>
                            }
                            <a asp-action="Edit" asp-route-id="@Model.BookingId" class="btn btn-sm btn-outline-primary px-3">
                                <i class="icon-pencil mr-1"></i> Edit
                            </a>
                            @if (Model.Status != "Cancelled" && Model.Status != "CheckedOut")
                            {
                                <form asp-action="Cancel" asp-route-id="@Model.BookingId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this reservation?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger px-3">Cancel</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
